{
  "name": "Futbol Training Lab",
  "install": "bash scripts/setup-cloud.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "npm run dev --prefix backend"
    },
    {
      "name": "frontend",
      "command": "node scripts/serve.mjs"
    }
  ],
  "ports": [
    { "name": "frontend", "port": 8080 },
    { "name": "api", "port": 3001 }
  ]
}
