# Backend
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string-in-production"
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:8080"
# Production: FRONTEND_URL="https://www.futbol-training-lab.com"

# Rate limiting (defaults shown). Auth is stricter to slow brute-force logins.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_API_MAX=600
# RATE_LIMIT_AUTH_MAX=10
# JSON_BODY_LIMIT=100kb
# TRUST_PROXY=1   # set automatically when NODE_ENV=production

# Stripe (get keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Created automatically by: npm run stripe:setup --prefix backend
STRIPE_PRICE_PLAYER="price_..."
STRIPE_PRICE_ELITE="price_..."
STRIPE_PRICE_TEAM="price_..."

# Optional: OpenAI for AI training plans (Elite tier)
OPENAI_API_KEY="sk-..."
